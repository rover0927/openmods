{
  "name": "openmods",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c green,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx apps/server/src/index.ts",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "build:bbcanvas": "node scripts/build-bbcanvas.mjs",
    "start": "cross-env NODE_ENV=production tsx apps/server/src/index.ts"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "undici": "^8.12.4"
  }
}
