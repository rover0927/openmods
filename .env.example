# LLM：任意 OpenAI 兼容端点（DeepSeek: https://api.deepseek.com）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-chat
# 1 = 离线演示（无需 key，脚本化假 LLM：输入"冰晶法杖"即可看到完整建模流程）
MOCK=1
PORT=8787
# 同时运行的建模子代理上限（每个子代理 = 独立子会话 + 独立画布 + 独立 SSE）
MAX_ACTIVE_SUBAGENTS=4

# —— 省 token（compaction）参数，留空用默认值 ——
# 触发阈值 = min(contextWindow × RATIO, budget − HEADROOM)
# COMPACTION_THRESHOLD_RATIO=0.8
# COMPACTION_HEADROOM_TOKENS=65536
# 保留最近 budget × RETAIN_RATIO 的原文不影子化
# COMPACTION_RETAIN_RATIO=0.16
# 影子 token 低于此值不压缩（不值得一次摘要调用）
# COMPACTION_MIN_SHADOWED=1200
# 演示压缩：小阈值 + 小保留，例如
# COMPACTION_THRESHOLD_RATIO=0.02
# COMPACTION_RETAIN_RATIO=0.02
# COMPACTION_MIN_SHADOWED=600
# 一轮内最多连续压几次（压一次仍超阈值时继续）
# COMPACTION_RETRIES=2
# 强行指定上下文窗口（正常情况下取模型目录里的 contextWindow，无需设置）
# COMPACTION_CONTEXT_WINDOW=1048576
